# Evaluation-only GLM-5.3-Flash EXL3 lane on Ron's Spark 2 + Spark 1 pair.
# Source recipe: MiaAI-Lab/GLM-5.3-Flash-EXL3-2x-DGX-Sparks @ b5ab809.
# This file contains no credentials. Keep VLLM_API_KEY out of Git.

HEAD_IP=192.168.6.48
WORKER_IP=192.168.6.109
WORKER_USER=spark1
WORKER_HOME=/home/spark1
WORKER_SSH=spark1@192.168.6.109

HEAD_CX7_IF=enp1s0f0np0
WORKER_CX7_IF=enp1s0f0np0
HEAD_CX7_IB=rocep1s0f0
WORKER_CX7_IB=rocep1s0f0
NCCL_IB_GID_INDEX=5
HEAD_GID=5
WORKER_GID=5
NCCL_CROSS_NIC=0
NCCL_DEBUG=WARN
USE_HOST_NCCL=0

MODEL=Mia-AiLab/GLM-5.3-Flash-EXL3-TR3-4bpw
MODEL_FALLBACK=brandonmusic/GLM-5.3-Flash-tr3-4bpw
MODEL_REVISION=25a44fdbf16862a46b7cc9921142c6c81350af2f
HF_HOME=/var/tmp/models/hf-exl3

IMAGE=ghcr.io/miaai-lab/glm-5.3-flash-2x-dgx-sparks@sha256:9bb1557a4234fce63d59599e44d10747eabd742beb337eebf9e7070be8a0fd58
PORT=8210
MASTER_PORT=29531
TP=2
NNODES=2
QUANTIZATION=exl3
SERVED_MODEL_NAME=glm-5.3-flash

SPEC_METHOD=dflash
DFLASH_MODEL=incoai/GLM-5.3-Flash-DFlash2
DFLASH_REVISION=dc77ff1c99eeb2df044ee3d4f0094eb033fee410
DFLASH_TOKENS=7
DFLASH_DRAFT_TP=2
MTP_TOKENS=2

MAX_MODEL_LEN=1000000
MAX_NUM_SEQS=4
MAX_NUM_BATCHED_TOKENS=2048
GPU_MEM_UTIL=0.87
KV_CACHE_DTYPE=fp8
ENFORCE_EAGER=0
EXL3_FUSED_MOE=1

LANGUAGE_MODEL_ONLY=0
SKIP_MM_PROFILING=1
LIMIT_MM='{"image":4,"video":1}'

ABLIT=1
ABLIT_METHOD=transplant
ABLIT_DONOR_REVISION=e90ef415a2bf1274f848965a61144eca1e99eabf
ABLIT_LAYERS=15-45
ABLIT_ALPHA=3.0
ABLIT_INCLUDE_MTP=1

GLM53_BOOT_SHAPE_WARMUP=1
GLM53_SUPPRESS_STOPS_IN_REASONING=1
GLM53_MIXED_PREFILL_CHUNK=skip
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
READY_TIMEOUT=3600

WORKER_VLLM_CACHE=/var/tmp/models/glm53-exl3-vllm-cache
WORKER_TRITON_CACHE=/var/tmp/models/glm53-exl3-vllm-cache/triton
WORKER_TILELANG_CACHE=/var/tmp/models/glm53-exl3-vllm-cache/tilelang
